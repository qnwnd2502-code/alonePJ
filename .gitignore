# 이전 학습물 보관 (로컬 전용, 커밋하지 않음)
_archive/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 로그 / 런타임 산출물
*.log

# 환경 변수 / 비밀키 — 절대 커밋 금지
.env
*.pem
*.key
# curl 실습에서 나오는 세션 쿠키. 남의 계정으로 로그인 가능한 값이다
cookie.txt
# TLS 인증서와 개인키. .key 가 새면 인증서는 그 순간 무효가 된다
certs/

# 로컬 전용 설정
.claude/settings.local.json

# OS
Thumbs.db
.DS_Store

# 자바 빌드 결과물. .java 를 컴파일한 .class 와 jar 가 쌓이는 곳이다.
# 소스만 있으면 언제든 다시 만들어지므로 커밋하지 않는다. (파이썬의 __pycache__ 와 같은 자리)
target/

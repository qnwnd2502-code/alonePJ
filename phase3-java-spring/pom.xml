<?xml version="1.0" encoding="UTF-8"?>
<!--
  pom.xml = Project Object Model.
  자바 세계의 '재료 주문서'다. 파이썬의 requirements.txt 와 같은 자리.
  회사(전자정부프레임워크) 프로젝트를 열어도 맨 위에 이 파일이 있다.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    parent = '상속'. 스프링 부트가 미리 정해둔 라이브러리 버전 목록을 통째로 물려받는다.
    이게 있어서 아래 dependency 에 <version> 을 안 적어도 된다.
    (자바에서 제일 흔한 사고가 '라이브러리 버전 충돌'인데, 그걸 대신 막아주는 장치다)
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <!-- 이 프로젝트의 이름표. groupId = 조직, artifactId = 프로젝트명 -->
  <groupId>com.study</groupId>
  <artifactId>demo</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!--
      starter-web 하나가 오늘의 핵심이다. 이 한 줄에 다음이 전부 딸려 온다:
        - Spring MVC   (요청을 어느 메서드로 보낼지 정하는 것)
        - 내장 Tomcat  (어제 우리가 직접 띄웠던 그 톰캣)
        - JSON 변환기  (자바 객체 -> JSON 자동 변환)
      '스타터'라는 이름이 붙은 건 '이거 하나 넣으면 세트로 온다'는 뜻이다.
    -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!--
      MyBatis. 자바 메서드 호출을 SQL 실행으로 바꿔주는 배달부.
      이것도 '스타터'라서 세트로 온다:
        - MyBatis 본체        (XML 의 SQL 을 찾아 실행)
        - Spring 연동         (@Mapper 를 스캔해서 빈으로 등록)
        - 커넥션 풀(HikariCP) (DB 연결을 미리 여러 개 만들어두고 돌려쓴다)

      버전을 직접 적은 이유: MyBatis 는 스프링 재단 소속이 아니라 별도 프로젝트라서
      spring-boot-starter-parent 가 버전을 대신 정해주지 않는다.
      (위 starter-web 에 <version> 이 없는 것과 비교해보면 차이가 보인다)
    -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>3.0.3</version>
    </dependency>

    <!--
      JDBC 드라이버. '자바 <-> PostgreSQL' 사이의 통역사다.
      DB 종류가 바뀌면 이 한 줄만 갈아끼운다.
      회사 소스에서는 이 자리에 보통 오라클(ojdbc)이나 티베로 드라이버가 들어있다.

      runtime = 컴파일할 때는 필요 없고, '실행할 때만' 필요하다는 표시.
      내 코드가 드라이버 클래스 이름을 직접 쓰지 않기 때문이다.
    -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- mvn spring-boot:run 명령을 쓸 수 있게 해주는 도구 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

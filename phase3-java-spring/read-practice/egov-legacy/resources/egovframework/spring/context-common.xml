<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
                           http://www.springframework.org/schema/beans/spring-beans.xsd
                           http://www.springframework.org/schema/context
                           http://www.springframework.org/schema/context/spring-context.xsd">

    <!-- ============ D ============ -->
    <context:component-scan base-package="egovframework">
        <context:exclude-filter type="annotation"
            expression="org.springframework.stereotype.Controller" />
    </context:component-scan>

    <!-- ============ E ============ -->
    <!--
      ★ 보안 주의 - 이 아래 비밀번호는 학습용 더미다 (전자정부 샘플의 기본값 sample/sample).
        실제 회사 소스가 이 모양인 경우가 흔하다. 문제점:
          1) 소스에 평문으로 박혀 있다 -> 형상관리(git/svn)에 그대로 올라간다
          2) 개발/운영 비밀번호가 다르면 파일을 갈아끼워야 한다 -> 사고의 원인
        요즘 방식은 4일차에 한 것처럼 환경변수로 주입한다:
            spring.datasource.password=
        전자정부에도 방법이 있다 - PropertyPlaceholderConfigurer 로 외부 properties 파일을
        읽거나, EgovEnvCryptoService 로 암호화한 값을 넣는다.
        ★ 회사 소스에서 이걸 발견하면 함부로 고치지 말고 먼저 물어볼 것.
          운영 배포 방식과 엮여 있어서 나 혼자 판단할 문제가 아니다.
    -->
    <bean id="dataSource"
          class="org.apache.commons.dbcp2.BasicDataSource"
          destroy-method="close">
        <property name="driverClassName" value="oracle.jdbc.driver.OracleDriver" />
        <property name="url" value="jdbc:oracle:thin:@localhost:1521:orcl" />
        <property name="username" value="sample" />
        <property name="password" value="sample" />
    </bean>

    <!-- ============ F ============ -->
    <bean id="sqlSession" class="org.mybatis.spring.SqlSessionFactoryBean">
        <property name="dataSource" ref="dataSource" />
        <property name="configLocation"
                  value="classpath:/egovframework/sqlmap/config/sql-mapper-config.xml" />
        <property name="mapperLocations"
                  value="classpath:/egovframework/sqlmap/example/*.xml" />
    </bean>

    <!-- ============ G ============ -->
    <bean id="egovIdGnrService"
          class="egovframework.rte.fdl.idgnr.impl.EgovTableIdGnrServiceImpl"
          destroy-method="destroy">
        <property name="dataSource" ref="dataSource" />
        <property name="strategy" ref="sampleStrategy" />
        <property name="blockSize" value="10" />
        <property name="table" value="IDS" />
        <property name="tableName" value="SAMPLE_ID" />
    </bean>

    <bean id="sampleStrategy"
          class="egovframework.rte.fdl.idgnr.impl.strategy.EgovIdGnrStrategyImpl">
        <property name="prefix" value="SAMPLE_" />
        <property name="cipers" value="8" />
        <property name="fillChar" value="0" />
    </bean>

</beans>

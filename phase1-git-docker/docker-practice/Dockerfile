# ─────────────────────────────────────────────────────────
# Dockerfile = 이미지를 만드는 레시피
# 위에서부터 한 줄씩 순서대로 실행된다.
# ─────────────────────────────────────────────────────────

# FROM: 바탕이 될 이미지. 맨바닥이 아니라 남이 만들어둔 것 위에서 시작한다.
#       slim = 불필요한 것을 뺀 가벼운 버전 (용량이 1/3 수준)
FROM python:3.13-slim

# WORKDIR: 앞으로의 작업 폴더. 없으면 자동으로 만들어준다.
#          이후 명령은 전부 이 폴더 기준으로 돈다.
WORKDIR /app

# COPY <내 PC> <컨테이너 안>
# requirements.txt 만 먼저 복사하는 이유:
#   Docker는 각 줄의 결과를 '레이어'로 저장해두고, 바뀐 게 없으면 재사용한다.
#   코드보다 의존성 목록이 훨씬 덜 바뀌므로, 먼저 깔아두면
#   코드만 고쳤을 때 pip install 을 건너뛰어 빌드가 몇 배 빨라진다.
COPY requirements.txt .

# RUN: 이미지를 만드는 '도중에' 실행할 명령
#      --no-cache-dir = pip 캐시를 남기지 않아 이미지 용량을 줄인다
RUN pip install --no-cache-dir -r requirements.txt

# 이제 나머지 소스 코드를 복사
COPY . .

# EXPOSE: "이 컨테이너는 8000번 포트를 쓴다"는 문서 역할.
#         실제로 포트를 열어주지는 않는다. 여는 건 docker run 의 -p 옵션.
EXPOSE 8000

# CMD: 컨테이너가 '시작될 때' 실행할 명령 (RUN 은 빌드 중, CMD 는 실행 시)
#      --host 0.0.0.0 이 핵심:
#        127.0.0.1 로 두면 컨테이너 '내부에서만' 접속 가능해서
#        밖(윈도우 브라우저)에서 열리지 않는다. 초보자가 가장 많이 겪는 함정.
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
